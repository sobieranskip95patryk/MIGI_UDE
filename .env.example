# ===== MIGI UNIFIED DEV ENVIRONMENT CONFIGURATION =====
# Copy this file to .env and customize your values
# Run: cp .env.example .env

# ===== GLOBAL DOMAIN & NETWORK =====
DOMAIN=localhost
NODE_ENV=development
ADMIN_EMAIL=admin@meta-geniusz.com

# ===== DATABASE CONFIGURATION =====
POSTGRES_DB=migi_ecosystem
POSTGRES_USER=migi
POSTGRES_PASSWORD=migi_secure_pass_change_in_production

# ===== REDIS CONFIGURATION =====
REDIS_PASSWORD=redis_secure_pass_change_in_production

# ===== JWT & AUTHENTICATION =====
JWT_SECRET=meta_geniusz_jwt_secret_dev_change_in_production
NEXTAUTH_SECRET=rocket_fuel_secret_dev_change_in_production
NEXTAUTH_URL=http://localhost

# ===== BLOCKCHAIN & SMART CONTRACTS =====
BLOCKCHAIN_RPC_URL=http://hardhat:8545
# Default Hardhat private key (DO NOT USE IN PRODUCTION)
DRIFT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract addresses (filled after deployment)
DRIFT_COIN_ADDRESS=0x0000000000000000000000000000000000000000
META_GENIUSZ_ADDRESS=0x0000000000000000000000000000000000000000

# ===== AI SERVICES CONFIGURATION =====
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ===== MONITORING & OBSERVABILITY =====
GRAFANA_PASSWORD=admin_change_in_production

# ===== EXTERNAL SERVICES =====
# Email service (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# File storage (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=migi-ecosystem-storage
AWS_REGION=us-east-1

# ===== DEVELOPMENT SETTINGS =====
# Ports (usually handled by docker-compose, but can be overridden)
GATEWAY_PORT=80
GATEWAY_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
HARDHAT_PORT=8545

# Service ports
META_GENIUSZ_PORT=8805
DRIFT_MONEY_PORT=8801
GOK_AI_PORT=8802
ROCKET_FUEL_PORT=3000
HIP_HOP_PORT=3001
SPIRALMIND_PORT=8806

# Monitoring ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# ===== API ENDPOINTS (auto-generated from DOMAIN) =====
# These are used by services to communicate with each other
API_BASE_URL=http://${DOMAIN:-localhost}/api
DRIFT_API_URL=http://${DOMAIN:-localhost}/api/drift
GOK_AI_API_URL=http://${DOMAIN:-localhost}/api/ai
MGS_API_URL=http://${DOMAIN:-localhost}/api/mgs
SPIRAL_API_URL=http://${DOMAIN:-localhost}/api/spiral

# Frontend URLs
ROCKET_FUEL_URL=http://app.${DOMAIN:-localhost}
HIP_HOP_URL=http://music.${DOMAIN:-localhost}
DASHBOARD_URL=http://dashboard.${DOMAIN:-localhost}
METRICS_URL=http://metrics.${DOMAIN:-localhost}

# ===== FEATURE FLAGS =====
ENABLE_MONITORING=true
ENABLE_BLOCKCHAIN=true
ENABLE_AI_SERVICES=true
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ===== BUSINESS LOGIC SETTINGS =====
# Meta-Geniusz consciousness system
MAX_CONSCIOUSNESS_LEVEL=6
CONSCIOUSNESS_UPDATE_INTERVAL=3600
DAILY_CONSCIOUSNESS_LIMIT=100

# Drift Money economic settings
INITIAL_TOKEN_SUPPLY=1000000
STAKING_REWARDS_ENABLED=true
TRANSACTION_FEE_PERCENTAGE=0.25

# GOK-AI settings
AI_MODEL_TIMEOUT=30
MAX_TOKENS_PER_REQUEST=4000
AI_CACHE_DURATION=300

# ===== SECURITY SETTINGS =====
# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
CORS_ORIGINS=http://localhost,http://app.localhost,http://music.localhost,http://dashboard.localhost

# Session settings
SESSION_TIMEOUT=3600
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ===== PRODUCTION OVERRIDES =====
# Uncomment and set for production deployment
# DOMAIN=meta-geniusz.com
# NODE_ENV=production
# POSTGRES_PASSWORD=ultra_secure_production_password
# REDIS_PASSWORD=ultra_secure_redis_password
# JWT_SECRET=ultra_secure_jwt_secret_64_chars_minimum
# NEXTAUTH_SECRET=ultra_secure_nextauth_secret
# GRAFANA_PASSWORD=secure_grafana_admin_password
# COOKIE_SECURE=true
# DEBUG_MODE=false
# VERBOSE_LOGGING=false

# ===== LOCAL DEVELOPMENT HELPERS =====
# Set to true to enable local development features
LOCAL_DEV_MODE=true
HOT_RELOAD=true
AUTO_RESTART=true

# Database seeding
SEED_DATABASE=true
SEED_ADMIN_EMAIL=admin@meta-geniusz.com
SEED_ADMIN_PASSWORD=admin123

# Mock services (for testing without external dependencies)
MOCK_AI_SERVICES=false
MOCK_BLOCKCHAIN=false
MOCK_EMAIL_SERVICE=true

# ===== DOCKER COMPOSE SETTINGS =====
COMPOSE_PROJECT_NAME=migi
COMPOSE_FILE=docker-compose.yml
COMPOSE_CONVERT_WINDOWS_PATHS=1

# Build settings
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1