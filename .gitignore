# MIGI UDE .gitignore

# Environment files
.env
.env.local
.env.production

# Logs
*.log
logs/
gateway/logs/

# Docker volumes data
postgres_data/
redis_data/
grafana_data/
prometheus_data/
loki_data/

# SSL certificates
gateway/letsencrypt/

# Backup files
backups/
*.backup
*.sql

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
.venv/
.env/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
.docker/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Build artifacts
dist/
build/
.next/
out/

# Coverage reports
coverage/
*.lcov

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file (keep .env.example)
.env*
!.env.example

# Kubernetes secrets
*.secret.yaml

# Helm charts dependencies
infra/k8s/charts/*/charts/
infra/k8s/charts/*/requirements.lock

# Local development overrides
docker-compose.override.yml
docker-compose.local.yml